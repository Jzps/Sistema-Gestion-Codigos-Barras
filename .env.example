# Copiar como .env y ajustar. NUNCA subir .env a git.

# --- Base de datos (backend) ---
DATABASE_URL=postgresql+psycopg://sgcbp:sgcbp@localhost:5432/sgcbp

# --- PostgreSQL en Docker Compose ---
POSTGRES_USER=sgcbp
POSTGRES_PASSWORD=sgcbp
POSTGRES_DB=sgcbp

# --- Seguridad ---
# Generar uno largo y aleatorio fuera de desarrollo, p. ej.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-key-change-me-32b
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false

# --- CORS (origen del frontend Angular) ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Seed de desarrollo (solo datos de ejemplo, documentados en README) ---
SEED_WORKSPACE_NAME=Demo Workspace
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
