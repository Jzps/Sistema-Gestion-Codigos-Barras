# Copiar como .env y ajustar. NUNCA subir .env a git.
#
# En produccion (Render) estas variables se configuran en el panel del
# servicio; este fichero es para el desarrollo local.

# --- Entorno ---
# "development" (local) | "production" (Render/Neon).
# En "production" la app NO arranca si SECRET_KEY es la de ejemplo,
# si COOKIE_SECURE=false o si CORS_ORIGINS apunta a localhost.
ENV=development

# --- Base de datos (backend) ---
# Local: PostgreSQL de Docker Compose.
# Neon:  postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://sgcbp:sgcbp@localhost:5432/sgcbp

# --- PostgreSQL en Docker Compose ---
POSTGRES_USER=sgcbp
POSTGRES_PASSWORD=sgcbp
POSTGRES_DB=sgcbp

# --- Seguridad ---
# Generar uno largo y aleatorio fuera de desarrollo, p. ej.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-key-change-me-32b
ACCESS_TOKEN_EXPIRE_MINUTES=720
# true obligatorio en produccion (HTTPS). Activarlo tambien activa la
# validacion estricta de la configuracion.
COOKIE_SECURE=false

# --- CORS (origen del frontend Angular) ---
# Local:  http://localhost:4200,http://127.0.0.1:4200
# Produccion: https://tu-frontend.onrender.com
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Servidor (Render asigna PORT; en local se usa 8000) ---
HOST=0.0.0.0
PORT=8000

# --- Seed de desarrollo (solo datos de ejemplo, documentados en README) ---
SEED_WORKSPACE_NAME=Demo Workspace
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
